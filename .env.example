# Copy to .env. These are development identifiers, not passwords.
AEGIS_ENV=development
AEGIS_VERSION=0.1.0-core-dev
AEGIS_TRADING_ENABLED=false
POSTGRES_DB=aegis
POSTGRES_USER=aegis
# Generate before first start: openssl rand -base64 36
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME_GENERATE_A_RANDOM_VALUE@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
# Generate before first start: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://aegis-alpha.pacificao.com
TRUSTED_HOSTS=localhost,127.0.0.1,aegis-alpha.pacificao.com
# Authentication deliberately fails closed until the host PAM bridge is installed.
PAM_BRIDGE_SOCKET=/run/aegis-auth/pam.sock
AUTHORIZED_USER=CHANGE_ME_TO_THE_LOCAL_OPERATOR_ACCOUNT
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_CONNECTION_CONFIGURED=false
BROKER_GATEWAY_URL=https://brokerage.aegis-alpha.pacificao.com
BROKER_GATEWAY_PRIVATE_IP=10.124.0.4
# Generate before start: openssl rand -hex 32
BROKER_GATEWAY_SHARED_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
BROKER_AUTHORIZATION_ENABLED=false
BROKER_GATEWAY_DATA_DIR=/var/lib/aegis-broker-gateway
BROKER_GATEWAY_KEY_FILE=/etc/aegis/broker-gateway.key
PUBLIC_BASE_URL=https://aegis-alpha.pacificao.com
AEGIS_UI_URL=https://aegis-alpha.pacificao.com
OAUTH_CALLBACK_BASE_URL=https://aegis-alpha.pacificao.com
OAUTH_REDIRECT_URI=https://aegis-alpha.pacificao.com/api/broker/robinhood/oauth/callback
NEXT_PUBLIC_API_BASE=/api
